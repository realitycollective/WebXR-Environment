{
  "name": "@realitycollective/threejs-environment",
  "version": "0.1.0-preview.1",
  "description": "three.js adapter for the Reality Collective WebXR Environment Extensions: an equirectangular gradient sky, linear and exponential fog, ambient and directional lighting, and Web Audio playback through AudioListener / PositionalAudio - all driven by the engine-free @realitycollective/webxr-environment core, which it re-exports.",
  "keywords": [
    "realitycollective",
    "webxr",
    "threejs",
    "xr",
    "environment",
    "skybox",
    "fog",
    "lighting",
    "audio",
    "typescript"
  ],
  "license": "MIT",
  "author": "Reality Collective",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@realitycollective/webxr-environment": "^0.1.0-preview.1"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "three": "npm:super-three@0.181.0",
    "@types/three": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realitycollective/WebXR-Environment.git",
    "directory": "packages/threejs-environment"
  },
  "homepage": "https://github.com/realitycollective/WebXR-Environment#readme",
  "bugs": {
    "url": "https://github.com/realitycollective/WebXR-Environment/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
