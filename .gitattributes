# Normalise to LF in the repository. The index already stores LF, so this pins
# the existing state rather than renormalising history - it stops Windows
# checkouts from re-committing CRLF churn (which is how committed build output
# shows up as "modified" on a clean rebuild).
* text=auto eol=lf

# Binary assets - never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf binary
*.hdr binary
*.ktx2 binary
*.tgz binary

# Lockfiles and generated output collapse in review.
# `linguist-generated` collapses these in GitHub review; they stay fully
# diffable locally (no `-diff`, which would render them as binary).
package-lock.json linguist-generated=true
