# `three` is aliased workspace-wide to Meta's super-three fork (root
# package.json `overrides`), because @iwsdk/core mandates it. The three.js
# adapter's peer range is written against three's own version line, which
# super-three tracks, so the pairing is correct at runtime - Vite and Node both
# resolve a single `three` - but npm's peer check compares package identity and
# cannot express "this alias is that package". Legacy resolution keeps `npm ci`
# and `verify:pack` honest instead of papering over it with a wider range.
legacy-peer-deps=true
